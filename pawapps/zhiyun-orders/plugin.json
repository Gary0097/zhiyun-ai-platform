{
  "id": "zhiyun-orders",
  "name": "订单与交付风险",
  "version": "1.0.0",
  "type": "app",
  "description": "在当前 Workspace 查询订单、识别交付风险并追踪每次执行。",
  "author": "Zhiyun AI",
  "entry": {
    "backend": "backend/main.py",
    "frontend": "ui/index.js"
  },
  "dependencies": [],
  "qwenpaw_version": {
    "min": "2.1.0",
    "max": "2.2.0"
  },
  "meta": {
    "pawapp": {
      "icon": "📦",
      "category": "business",
      "entry_page": "/apps/zhiyun-orders",
      "launch_scope": "page"
    },
    "permissions": {
      "chat": true,
      "storage": false
    },
    "tools": [
      {
        "name": "orders_query",
        "description": "查询当前企业 Workspace 中的订单，可按订单号、状态和风险等级筛选；返回真实订单和 Trace ID",
        "icon": "📦",
        "requires_config": false
      },
      {
        "name": "orders_delivery_risk",
        "description": "分析当前企业 Workspace 的订单交付风险，返回红黄绿风险清单、原因和 Trace ID",
        "icon": "⚠️",
        "requires_config": false
      }
    ]
  }
}
