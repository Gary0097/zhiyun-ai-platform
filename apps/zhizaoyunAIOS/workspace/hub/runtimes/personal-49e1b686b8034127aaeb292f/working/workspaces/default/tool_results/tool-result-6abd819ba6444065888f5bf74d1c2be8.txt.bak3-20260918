AIL, \"password\": PASSWORD})\n    if not r.get(\"success\"):\n        raise RuntimeError(\"登录失败: \" + json.dumps(r, ensure_ascii=False)[:300])\n    return r[\"token\"]\n\n\ndef create_session(token, kb_ids):\n    body = {\n        \"agent_config\": {\n            \"enabled\": True,\n            \"max_iterations\": 5,\n            \"temperature\": 0.7,\n            \"knowledge_bases\": kb_ids,\n            \"knowledge_ids\": [],\n            \"allowed_tools\": [],\n        }\n    }\n    r = post_json(BASE + \"/api/v1/sessions\", body, token)\n    return r[\"data\"][\"id\"]\n\n\ndef ask(token, session_id, query):\n    body = {\n        \"query\": query,\n        \"agent_enabled\": False,\n        \"agent_id\": \"builtin-quick-answer\",\n        \"web_search_enabled\": False,\n        \"summary_model_id\": SUMMARY_MODEL_ID,\n        \"channel\": \"web\",\n    }\n    data = json.dumps(body, ensure_ascii=False).encode(\"utf-8\")\n    req = urllib.request.Request(\n        BASE + \"/api/v1/knowledge-chat/\" + session_id,\n        data=data,\n        headers={\"Content-Type\": \"application/json\", \"Authorization\": \"Bearer \" + token},\n        method=\"POST\",\n    )\n    answer_parts, refs, done = [], [], False\n    with urllib.request.urlopen(req, timeout=300) as resp:\n        for raw_line in resp:\n            line = raw_line.decode(\"utf-8\").strip()\n            if not line.startswith(\"data:\"):\n                continue\n            try:\n                evt = json.loads(line[5:])\n            except json.JSONDecodeError:\n                continue\n            rt = evt.get(\"response_type\")\n            if rt == \"answer\":\n                answer_parts.append(evt.get(\"content\", \"\"))\n            elif rt == \"reference\" and evt.get(\"data\"):\n                d = evt[\"data\"]\n                name = d.get(\"knowledge_name\") or d.get(\"file_name\") or \"\"\n                if name:\n                    refs.append(name)\n            if evt.get(\"done\") and rt not in (\"answer\",):\n                pass\n    return \"\".join(answer_parts), refs\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"智造云知识库问数\")\n    ap.add_argument(\"query\", help=\"要询问知识库的问题\")\n    ap.add_argument(\"--kb\", default=DEFAULT_KB, help=\"知识库ID，多个用逗号分隔\")\n    args = ap.parse_args()\n\n    kb_ids = [x.strip() for x in args.kb.split(\",\") if x.strip()]\n    try:\n        token = login()\n        sid = create_session(token, kb_ids)\n        answer, refs = ask(token, sid, args.query)\n    except Exception as e:\n        print(\"知识库问数失败: %s\" % e, file=sys.stderr)\n        sys.exit(1)\n\n    print(answer.strip())\n    if refs:\n        print(\"\\n\\n参考来源: \" + \"；\".join(dict.fromkeys(refs)))\n\n\nif __name__ == \"__main__\":\n    main()\n", "id": "2635b13c988640e6a5ea06da3b07ccaa", "created_at": "2026-09-17T19:59:55.308426", "finished_at": null}], "state": "success", "metadata": {}, "created_at": "2026-09-17T19:59:55.312268", "finished_at": null}, {"type": "tool_result", "id": "call_88c90ea92b63483eaf426727", "name": "read_file", "output": [{"type": "text", "text": "---\nname: weknora_kb_qa\ndescription: \"智造云知识库(WeKnora)问数技能。当用户询问金汉隆/公司产品、设备型号、技术规格、包装机、装盒机、售后服务、生产工艺等企业知识问题，或明确要求查询知识库/问数时使用。通过 WeKnora API 检索知识库并生成基于文档的回答。Use when the user asks about company products, equipment specs, packaging machinery knowledge, or explicitly requests a knowledge-base lookup.\"\nmetadata:\n  builtin_skill_version: \"1.0\"\n  qwenpaw:\n    emoji: \"📚\"\n    requires: {}\n---\n\n# 智造云知识库问数 (WeKnora Knowledge QA)\n\n通过本技能调用智造云知识库（WeKnora，服务地址 http://127.0.0.1:18000）的「通用产品知识库」进行检索问答（问数）。回答基于知识库中的真实文档，涉及产品型号、技术参数、适用范围等事实性问题必须优先使用本技能。\n\n## 使用方法\n\n本技能所在目录下有 `scripts/ask_weknora.py`（以本 SKILL.md 所在目录为根）。对用户的问题，在本技能目录中执行：\n\n```bash\npython3 scripts/ask_weknora.py \"用户的问题\"\n```\n\n（若当前目录不是本技能目录，先用 find/glob 定位 `weknora_kb_qa/scripts/ask_weknora.py` 再执行。）\n\n脚本会自动完成登录、创建会话、绑定知识库、提问并汇总回答，最终把知识库生成的完整答案打印到 stdout。把该答案作为回答依据整理后回复用户。\n\n说明：\n- 脚本参数即自然语言问