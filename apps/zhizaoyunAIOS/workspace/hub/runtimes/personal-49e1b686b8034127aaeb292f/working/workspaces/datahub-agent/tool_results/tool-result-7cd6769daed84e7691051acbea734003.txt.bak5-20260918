SELECT event_status, COUNT(*) n FROM logistics_events GROUP BY event_status\\\" 2>&1\\necho \\\"=== 主计算：按订单预聚合已签收数量 ===\\\"\\npython3 datahub/scripts/query.py \\\"\\nWITH rec AS (\\n  SELECT sales_order_id,\\n         SUM(CASE WHEN received_at IS NOT NULL THEN quantity ELSE 0 END) AS received_qty,\\n         SUM(quantity) AS shipped_qty,\\n         COUNT(*) AS batches,\\n         MAX(received_at) AS last_received_at\\n  FROM shipments GROUP BY sales_order_id\\n)\\nSELECT CASE\\n         WHEN o.quantity = COALESCE(rec.received_qty,0) THEN 'A_全量签收'\\n         WHEN COALESCE(rec.received_qty,0) > o.quantity THEN 'B_超签(异常)'\\n         WHEN rec.received_qty > 0 THEN 'C_部分签收'\\n         WHEN COALESCE(rec.shipped_qty,0) > 0 THEN 'D_已发货未签收'\\n         WHEN rec.sales_order_id IS NOT NULL THEN 'E_有运单未发货'\\n         ELSE 'F_无运单'\\n       END AS state,\\n       COUNT(*) AS n\\nFROM v_current_orders o LEFT JOIN rec ON rec.sales_order_id=o.sales_order_id\\nGROUP BY state ORDER BY state\\\" 2>&1\"}", "state": "finished", "suggested_rules": [], "created_at": "2026-09-17T22:59:16.223080", "finished_at": null}, {"type": "tool_result", "id": "call_cd8a09acb37541789be0ac2d", "name": "execute_shell_command", "output": [{"type": "text", "text": "cid | name | type | notnull | dflt_value | pk\n----------------------------------------\n0 | exception_id | TEXT | 0 |  | 1\n1 | sales_order_id | TEXT | 0 |  | 0\n2 | work_order_id | TEXT | 0 |  | 0\n3 | exception_type | TEXT | 0 |  | 0\n4 | severity | TEXT | 0 |  | 0\n5 | opened_at | TEXT | 0 |  | 0\n6 | closed_at | TEXT | 0 |  | 0\n7 | status | TEXT | 0 |  | 0\n8 | reason | TEXT | 0 |  | 0\n9 | source_record_id | TEXT | 0 |  | 0\n(10 rows)\n=== logistics event_status ===\nevent_status | n\n----------------------------------------\n已揽收 | 746\n已签收 | 724\n运输中 | 746\n运输延误 | 312\n(4 rows)\n=== 主计算：按订单预聚合已签收数量 ===\nstate | n\n----------------------------------------\nA_全量签收 | 680\nD_已发货未签收 | 22\nF_无运单 | 67\n(3 rows)", "id": "6c8d94f24cfa4f65900c43add7