_inspections', COUNT(*) FROM wms_transactions w LEFT JOIN quality_inspections q ON q.inspection_id=w.reference_id WHERE w.movement_type='成品入库' AND q.inspection_id IS NULL\\nUNION ALL SELECT 'PO-M ref不在procurement_lines', COUNT(*) FROM wms_transactions w LEFT JOIN procurement_lines p ON p.po_line_id=w.reference_id WHERE w.reference_id LIKE 'PO-M%' AND p.po_line_id IS NULL\\n\\\" 2>&1 | head -20\\necho \\\"=== shipments status ===\\\"\\npython3 datahub/scripts/query.py \\\"SELECT status, COUNT(*) n, SUM(quantity) q FROM shipments GROUP BY status\\\"\"}\n[tool_call name=execute_shell_command id=call_43c923e0b55a4b579b3c4248]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT 'wms时间格式异常' chk, COUNT(*) n FROM wms_transactions WHERE occurred_at NOT LIKE '_____.__-__T__:__:__+__:__'\\nUNION ALL SELECT 'shipments.dispatched格式异常', COUNT(*) FROM shipments WHERE dispatched_at IS NOT NULL AND dispatched_at NOT LIKE '_____.__-__T__:__:__+__:__'\\nUNION ALL SELECT 'shipments.received格式异常', COUNT(*) FROM shipments WHERE received_at IS NOT NULL AND received_at NOT LIKE '_____.__-__T__:__:__+__:__'\\nUNION ALL SELECT 'orders.created格式异常', COUNT(*) FROM orders WHERE created_at NOT LIKE '_____.__-__T__:__:__+__:__'\\nUNION ALL SELECT 'orders.promised格式异常', COUNT(*) FROM orders WHERE promised_delivery_at NOT LIKE '_____.__-__T__:__:__+__:__'\\n\\\"\\necho \\\"=== distinct tail ===\\\"\\npython3 datahub/scripts/query.py \\\"SELECT DISTINCT SUBSTR(occurred_at,-6) tail, COUNT(*) n FROM wms_transactions GROUP BY 1\\\"\"}\n[tool_call name=execute_shell_command id=call_67722d5cefcb41b2be34354f]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT 'wms时间长度≠25' chk, COUNT(*) n FROM wms_transactions WHERE LENGTH(occurred_at)<>25\\nUNION ALL SELECT 'ship.dispatched长度≠25', COUNT(*) FROM shipments WHERE dispatched_at IS NOT NULL AND LENGTH(dispatched_at)<>25\\nUNION ALL SELECT 'ship.received长度≠25', COUNT(*) FROM shipments WHERE received_at IS NOT NULL AND LENGTH(received_at)<>25\\nUNION ALL SELECT 'orders.created长度≠25', COUNT(*) FROM orders WHERE LENGTH(created_at)<>25\\nUNION ALL SELECT 'orders.promised长度≠25', COUNT(*) FROM orders WHERE LENGTH(promised_delivery_at)<>25\\nUNION ALL SELECT 'wo.released长度≠25', COUNT(*) FROM work_orders WHERE released_at IS NOT NULL AND LENGTH(released_at)<>25\\nUNION ALL SELECT 'wo.planned_finish长度≠25', COUNT(*) FROM work_orders WHERE planned_finish_at IS NOT NULL AND LENGTH(planned_finish_at)<>25\\nUNION ALL SELECT 'proc.actual_receipt长度≠25', COUNT(*) FROM procurement_lines WHERE actual_receipt_at IS NOT NULL AND LENGTH(actual_receipt_at)<>25\\nUNION ALL SELECT 'proc.promised_receipt长度≠25', COUNT(*) FROM procurement_lines WHERE promised_receipt_at IS NOT NULL AND LENGTH(promised_receipt_at)<>25\\nUNION ALL SELECT 'qi.inspected长度≠25', COUNT(*) FROM quality_inspections WHERE inspected_at IS NOT NULL AND LENGTH(inspected_at)<>25\\n\\\"\"}\n[tool_call name=execute_shell_command id=call_69580882acbc4a0ebfeff62c]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nWITH so AS (\\n  SELECT reference_id shp, -SUM(signed_quantity) qty, COUNT(*) n\\n  FROM wms_transactions WHERE movement_type='销售出库' GROUP BY reference_id)\\nSELECT '运单出库数量≠shipments.quantity' chk, COUNT(*) n\\nFROM shipments s JOIN so ON so.shp=s.shipment_id WHERE so.qty<>s.quantity\\nUNION ALL SELECT '运单无对应销售出库流水', COUNT(*) FROM shipments s LEFT JOIN so ON so.shp=s.shipment_id WHERE so.shp IS NULL\\nUNION ALL SELECT '销售出库ref无对应运单', COUNT(*) FROM so LEFT JOIN shipments s ON s.shipment_id=so.shp WHERE s.shipment_id IS NULL\\n\\\"\\necho \\\"--- 订单级数量 ---\\\"\\npython3 datahub/scripts/query.py \\\"\\nWITH sh AS (SELECT sales_order_id, SUM(quantity) q, SUM(CASE WHEN status='已签收' THEN quantity ELSE 0 END) q_signed FROM shipments GROUP BY 1),\\nfg AS (SELECT sales_order_id, SUM(signed_quantity) q FROM wms_transactions WHERE movement_type='成品入库' GROUP BY 1),\\nob AS (SELECT sales_order_id, SUM(-signed_quantity) q FROM wms_transactions WHERE movement_type='销售出库' GROUP BY 1)\\nSELECT o.sales_order_id, o.quantity ord_q, sh.q ship_q, sh.q_signed signed_q, fg.q fg_q, ob.q out_q, o.unit\\nFROM orders o LEFT JOIN sh ON sh.sales_order_id=o.sales_order_id LEFT JOIN fg ON fg.sales_order_id=o.sales_order_id LEFT JOIN ob ON ob.sales_order_id=o.sales_order_id\\nWHERE o.is_effective=1 AND (IFNULL(sh.q,0)>o.quantity OR IFNULL(sh.q_signed,0)>o.quantity OR IFNULL(fg.q,0)>o.quantity OR IFNULL(ob.q,0)<>IFNULL(sh.q,0))\\nLIMIT 40\\\"\"}\n[tool_call name=execute_shell_command id=call_f50b9430a90e4fc6bf72fd95]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT '发货数量单位≠订单单位' chk, COUNT(*) n FROM shipments s JOIN orders o ON o.sales_order_id=s.sales_order_id WHERE s.unit<>o.unit\\nUNION ALL SELECT '工单计划数量≠订单数量', COUNT(*) FROM work_orders t JOIN orders o ON o.sales_order_id=t.sales_order_id WHERE t.planned_quantity<>o.quantity\\nUNION ALL SELECT '工单单位≠订单单位', COUNT(*) FROM work_orders t JOIN orders o ON o.sales_order_id=t.sales_order_id WHERE t.unit<>o.unit\\nUNION ALL SELECT '质检 accepted+defective≠inspected', COUNT(*) FROM quality_inspections WHERE accepted_quantity+defective_quantity<>inspected_quantity\\nUNION ALL SELECT '采购入库数量≠采购单ordered_quantity', COUNT(*) FROM (\\n  SELECT w.reference_id FROM wms_transactions w JOIN procurement_lines p ON p.purchase_line_id=w.reference_id\\n  WHERE w.movement_type='采购入库' GROUP BY w.reference_id HAVING SUM(w.signed_quantity)<>MAX(p.ordered_quantity))\\nUNION ALL SELECT '采购流水单位≠采购单单位', COUNT(*) FROM wms_transactions w JOIN procurement_lines p ON p.purchase_line_id=w.reference_id WHERE w.unit<>p.unit\\nUNION ALL SELECT '成品入库数量≠质检accepted', COUNT(*) FROM (\\n  SELECT w.reference_id FROM wms_transactions w JOIN quality_inspections q ON q.inspection_id=w.reference_id\\n  WHERE w.movement_type='成品入库' GROUP BY w.reference_id HAVING SUM(w.signed_quantity)<>MAX(q.accepted_quantity))\\n\\\"\"}\n[tool_call name=execute_shell_command id=call_c818787d032146128cd4e8e6]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT inspection_id, sales_order_id, work_order_id, product_id, inspection_type,\\n       inspected_quantity insp, accepted_quantity acc, defective_quantity def,\\n       inspected_quantity-accepted_quantity-defective_quantity gap, result, inspected_at\\nFROM quality_inspections\\nWHERE accepted_quantity+defective_quantity<>inspected_quantity\\nORDER BY ABS(inspected_quantity-accepted_quantity-defective_quantity) DESC\\nLIMIT 60\\\" --limit 60\"}\n[tool_call name=execute_shell_command id=call_5fa2c8f419e249ffa9c1c5c2]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT result, COUNT(*) n, SUM(CASE WHEN accepted_quantity+defective_quantity<>inspected_quantity THEN 1 ELSE 0 END) bad\\nFROM quality_inspections GROUP BY result\\\"\\necho \\\"--- 不合格质检是否有成品入库 ---\\\"\\npython3 datahub/scripts/query.py \\\"\\nSELECT '不合格质检却有成品入库' chk, COUNT(*) n FROM quality_inspections q JOIN wms_transactions w ON w.reference_id=q.inspection_id\\nWHERE w.movement_type='成品入库' AND q.result NOT IN ('合格','通过','PASS','pass')\\nUNION ALL SELECT '质检result取值', COUNT(DISTINCT result) FROM quality_inspections\\nUNION ALL SELECT '成品入库ref指向不合格质检', COUNT(DISTINCT w.reference_id) FROM wms_transactions w JOIN quality_inspections q ON q.inspection_id=w.reference_id WHERE w.movement_type='成品入库' AND q.result<>'合格'\\\"\"}\n[tool_call name=execute_shell_command id=call_b43a6180e290455489fb42b4]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"SELECT fulfillment_mode, COUNT(*) n FROM orders WHERE is_effective=1 GROUP BY 1\\\"\\necho \\\"--- 外购单：流水构成 ---\\\"\\npython3 datahub/scripts/query.py \\\"\\nSELECT o.fulfillment_mode, w.movement_type, COUNT(*) n, SUM(ABS(w.signed_quantity)) qty\\nFROM wms_transactions w JOIN orders o ON o.sales_order_id=w.sales_order_id\\nGROUP BY 1,2 ORDER BY 1,3 DESC\\\"\"}\n[tool_call name=execute_shell_command id=call_7d3e792f68324c13ad835480]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nWITH conv AS (SELECT sales_order_id, SUM(-signed_quantity) q FROM wms_transactions WHERE movement_type='外购转成品' GROUP BY 1),\\nfg AS (SELECT sales_order_id, SUM(signed_quantity) q FROM wms_transactions WHERE movement_type='成品入库' GROUP BY 1),\\nob AS (SELECT sales_order_id, SUM(-signed_quantity) q FROM wms_transactions WHERE movement_type='销售出库' GROUP BY 1)\\nSELECT '外购转成品订单数' k, COUNT(*) v FROM conv\\nUNION ALL SELECT '其中有成品入库的', COUNT(*) FROM conv c JOIN fg ON fg.sales_order_id=c.sales_order_id\\nUNION ALL SELECT '其中入库量=转成品量的', COUNT(*) FROM conv c JOIN fg ON fg.sales_order_id=c.sales_order_id AND fg.q=c.q\\nUNION ALL SELECT '其中入库量≠转成品量的', COUNT(*) FROM conv c JOIN fg ON fg.sales_order_id=c.sales_order_id AND fg.q<>c.q\\nUNION ALL SELECT '转成品量≠订单量', COUNT(*) FROM conv c JOIN orders o ON o.sales_order_id=c.sales_order_id WHERE c.q<>o.quantity\\nUNION ALL SELECT '外购单销售出库量≠转成品量', COUNT(*) FROM conv c JOIN ob ON ob.sales_order_id=c.sales_order_id WHERE ob.q<>c.q\\n\\\"\"}\n[tool_call name=execute_shell_command id=call_ee14cfc33ac24f59b0f8319b]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nWITH ob AS (SELECT DISTINCT sales_order_id FROM wms_transactions WHERE movement_type='销售出库'),\\nfg AS (SELECT DISTINCT sales_order_id FROM wms_transactions WHERE movement_type='成品入库')\\nSELECT '有销售出库但无成品入库的订单' k, COUNT(*) v FROM ob LEFT JOIN fg USING(sales_order_id) WHERE fg.sales_order_id IS NULL\\nUNION ALL SELECT '有成品入库但无销售出库的订单', COUNT(*) FROM fg LEFT JOIN ob USING(sales_order_id) WHERE ob.sales_order_id IS NULL\\n\\\"\\necho \\\"--- lot 跨订单复用 ---\\\"\\npython3 datahub/scripts/query.py \\\"\\nSELECT movement_type, COUNT(*) groups, SUM(rows_) rows_, SUM(orders_per_lot) ord_refs FROM (\\n SELECT lot_id, movement_type, COUNT(*) rows_, COUNT(DISTINCT sales_order_id) orders_per_lot\\n FROM wms_transactions GROUP BY lot_id, movement_type) WHERE orders_per_lot>1 GROUP BY movement_type\\\"\\necho \\\"--- 同一lot被多个订单销售出库 ---\\\"\\npython3 datahub/scripts/query.py \\\"\\nSELECT lot_id, COUNT(DISTINCT sales_order_id) orders_, COUNT(*) rows_, SUM(-signed_quantity) qty, GROUP_CONCAT(DISTINCT sales_order_id) sos\\nFROM wms_transactions WHERE movement_type='销售出库' GROUP BY lot_id HAVING COUNT(DISTINCT sales_order_id)>1 ORDER BY orders_ DESC LIMIT 20\\\"\"}\n[tool_call name=execute_shell_command id=call_fecfb2c59bf5410d85356eb7]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT o.sales_order_id, o.fulfillment_mode, o.quantity, o.unit, o.is_effective,\\n  (SELECT SUM(-signed_quantity) FROM wms_transactions w WHERE w.sales_order_id=o.sales_order_id AND w.movement_type='外购转成品') conv,\\n  (SELECT SUM(signed_quantity) FROM wms_transactions w WHERE w.sales_order_id=o.sales_order_id AND w.movement_type='成品入库') fg,\\n  (SELECT SUM(-signed_quantity) FROM wms_transactions w WHERE w.sales_order_id=o.sales_order_id AND w.movement_type='销售出库') out_,\\n  (SELECT SUM(quantity) FROM shipments s WHERE s.sales_order_id=o.sales_order_id) ship\\nFROM orders o\\nWHERE o.sales_order_id IN (SELECT sales_order_id FROM wms_transactions WHERE movement_type='外购转成品')\\n  AND o.sales_order_id NOT IN (SELECT sales_order_id FROM wms_transactions WHERE movement_type='成品入库')\\nLIMIT 20\\\"\"}\n[tool_call name=execute_shell_command id=call_fbbb80e450a3404f87355ef5]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nWITH conv AS (SELECT w.sales_order_id, MIN(w.occurred_at) t FROM wms_transactions w WHERE w.movement_type='外购转成品' GROUP BY 1),\\nfgt AS (SELECT w.sales_order_id, MIN(w.occurred_at) t FROM wms_transactions w WHERE w.movement_type='成品入库' GROUP BY 1)\\nSELECT CAST(JULIANDAY(fg.t)-JULIANDAY(c.t) AS INTEGER) lag_days, COUNT(*) n\\nFROM conv c JOIN fgt fg ON fg.sales_order_id=c.sales_order_id GROUP BY 1 ORDER BY 1\\\"\\necho \\\"--- 9单转成品时间 & 快照 ---\\\"\\npython3 datahub/scripts/query.py \\\"\\nSELECT sales_order_id, MIN(occurred_at) conv_at, GROUP_CONCAT(transaction_id) txns\\nFROM wms_transactions WHERE movement_type='外购转成品' AND sales_order_id IN\\n('SO20260901-0212','SO20260903-0209','SO20260905-00508','SO20260910-00437','SO20260914-00573','SO20260914-0204','SO20260914-0208','SO20260915-00591','SO20260915-0210')\\nGROUP BY 1 ORDER BY 2\\\"\"}\n[tool_call name=execute_shell_command id=call_2af34587e13c4ef3894e2b7c]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT '运单:签收早于发货' chk, COUNT(*) n FROM shipments WHERE received_at IS NOT NULL AND dispatched_at IS NOT NULL AND received_at<dispatched_at\\nUNION ALL SELECT '运单:发货晚于快照', COUNT(*) FROM shipments WHERE dispatched_at>'2026-09-18T08:00:00+08:00'\\nUNION ALL SELECT '运单:签收晚于快照', COUNT(*) FROM shipments WHERE received_at>'2026-09-18T08:00:00+08:00'\\nUNION ALL SELECT '运单:已签收但received为空', COUNT(*) FROM shipments WHERE status='已签收' AND received_at IS NULL\\nUNION ALL SELECT '运单:在途但有received_at', COUNT(*) FROM shipments WHERE status='在途' AND received_at IS NOT NULL\\nUNION ALL SELECT '运单:received为空但dispatched为空', COUNT(*) FROM shipments WHERE dispatched_at IS NULL\\nUNION ALL SELECT '销售出库晚于运单发货', COUNT(*) FROM wms_transactions w JOIN shipments s ON s.shipment_id=w.reference_id WHERE w.movement_type='销售出库' AND w.occurred_at>s.dispatched_at\\nUNION ALL SELECT '销售出库早于运单发货(>7天)', COUNT(*) FROM wms_transactions w JOIN shipments s ON s.shipment_id=w.reference_id WHERE w.movement_type='销售出库' AND w.occurred_at<datetime(s.dispatched_at,'-7 days')\\nUNION ALL SELECT '成品入库晚于销售出库', COUNT(*) FROM (SELECT w1.sales_order_id FROM wms_transactions w1 WHERE w1.movement_type='成品入库' AND EXISTS(SELECT 1 FROM wms_transactions w2 WHERE w2.movement_type='销售出库' AND w2.sales_order_id=w1.sales_order_id AND w2.occurred_at<w1.occurred_at))\\nUNION ALL SELECT '订单:承诺交期早于下单', COUNT(*) FROM orders WHERE promised_delivery_at<created_at\\nUNION ALL SELECT '工单:计划完工早于下达', COUNT(*) FROM work_orders WHERE planned_finish_at<released_at\\nUNION ALL SELECT '工单:计划完工晚于承诺交期', COUNT(*) FROM work_orders t JOIN orders o ON o.sales_order_id=t.sales_order_id WHERE t.planned_finish_at>o.promised_delivery_at\\n\\\"\"}\n[tool_call name=execute_shell_command id=call_f2ba0f6e6e474a5890111ed6]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT '节点:实际开始>实际结束' chk, COUNT(*) n FROM stage_nodes WHERE actual_start_at IS NOT NULL AND actual_end_at IS NOT NULL AND actual_start_at>actual_end_at\\nUNION ALL SELECT '节点:实际结束晚于快照', COUNT(*) FROM stage_nodes WHERE actual_end_at>'2026-09-18T08:00:00+08:00'\\nUNION ALL SELECT '节点:实际开始晚于快照', COUNT(*) FROM stage_nodes WHERE actual_start_at>'2026-09-18T08:00:00+08:00'\\nUNION ALL SELECT '节点:计划结束早于计划开始', COUNT(*) FROM stage_nodes WHERE planned_end_at<planned_start_at\\nUNION ALL SELECT '节点:有实际开始但工单未下达', COUNT(*) FROM stage_nodes s JOIN work_orders t ON t.work_order_id=s.work_order_id WHERE s.actual_start_at<t.released_at\\nUNION ALL SELECT '节点:已完成但状态未完成', COUNT(*) FROM stage_nodes WHERE actual_end_at IS NOT NULL AND stage_status NOT IN ('已完成','完成')\\nUNION ALL SELECT '节点:未完成但有实际结束', COUNT(*) FROM stage_nodes WHERE actual_end_at IS NOT NULL AND stage_status IN ('进行中','未开始')\\nUNION ALL SELECT 'MES:start>end', COUNT(*) FROM mes_events WHERE start_at>end_at\\nUNION ALL SELECT 'MES:end晚于快照', COUNT(*) FROM mes_events WHERE end_at>'2026-09-18T08:00:00+08:00'\\nUNION ALL SELECT 'MES:duration与end-start不符', COUNT(*) FROM mes_events WHERE ABS((JULIANDAY(end_at)-JULIANDAY(start_at))*1440-duration_minutes)>0.02\\nUNION ALL SELECT '异常:closed<opened', COUNT(*) FROM exceptions WHERE closed_at IS NOT NULL AND opened_at IS NOT NULL AND closed_at<opened_at\\nUNION ALL SELECT '异常:closed晚于快照', COUNT(*) FROM exceptions WHERE closed_at>'2026-09-18T08:00:00+08:00'\\nUNION ALL SELECT '质检:inspected晚于快照', COUNT(*) FROM quality_inspections WHERE inspected_at>'2026-09-18T08:00:00+08:00'\\nUNION ALL SELECT '物流事件晚于快照', COUNT(*) FROM logistics_events WHERE event_at>'2026-09-18T08:00:00+08:00'\\n\\\"\"}\n[tool_call name=execute_shell_command id=call_999aeeb2eed545818322893e]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT '采购入库早于采购单下单时间' chk, COUNT(*) n FROM wms_transactions w JOIN procurement_lines p ON p.purchase_line_id=w.reference_id WHERE w.movement_type='采购入库' AND w.occurred_at<p.ordered_at\\nUNION ALL SELECT '采购入库≠采购单actual_receipt_at', COUNT(*) FROM wms_transactions w JOIN procurement_lines p ON p.purchase_line_id=w.reference_id WHERE w.movement_type='采购入库' AND w.occurred_at<>p.actual_receipt_at\\nUNION ALL SELECT '采购单有actual_receipt但无入库流水', COUNT(*) FROM procurement_lines p LEFT JOIN wms_transactions w ON w.reference_id=p.purchase_line_id AND w.movement_type='采购入库' WHERE p.actual_receipt_at IS NOT NULL AND w.transaction_id IS NULL\\nUNION ALL SELECT '采购单无actual_receipt却有入库流水', COUNT(*) FROM wms_transactions w JOIN procurement_lines p ON p.purchase_line_id=w.reference_id WHERE w.movement_type='采购入库' AND p.actual_receipt_at IS NULL\\nUNION ALL SELECT '采购actual_receipt晚于promised_receipt', COUNT(*) FROM procurement_lines WHERE actual_receipt_at IS NOT NULL AND promised_receipt_at IS NOT NULL AND actual_receipt_at>promised_receipt_at\\nUNION ALL SELECT '采购actual_receipt晚于快照', COUNT(*) FROM procurement_lines WHERE actual_receipt_at>'2026-09-18T08:00:00+08:00'\\nUNION ALL SELECT '生产领料早于工单下达', COUNT(*) FROM wms_transactions w JOIN work_orders t ON t.work_order_id=w.work_order_id WHERE w.movement_type='生产领料' AND w.occurred_at<t.released_at\\nUNION ALL SELECT '生产领料晚于计划完工', COUNT(*) FROM wms_transactions w JOIN work_orders t ON t.work_order_id=w.work_order_id WHERE w.movement_type='生产领料' AND w.occurred_at>t.planned_finish_at\\nUNION ALL SELECT '成品入库早于质检时间', COUNT(*) FROM wms_transactions w JOIN quality_inspections q ON q.inspection_id=w.reference_id WHERE w.movement_type='成品入库' AND w.occurred_at<q.inspected_at\\nUNION ALL SELECT '成品入库早于工单下达', COUNT(*) FROM wms_transactions w JOIN work_orders t ON t.work_order_id=w.work_order_id WHERE w.movement_type='成品入库' AND w.occurred_at<t.released_at\\nUNION ALL SELECT '采购入库早于订单创建', COUNT(*) FROM wms_transactions w JOIN orders o ON o.sales_order_id=w.sales_order_id WHERE w.movement_type='采购入库' AND w.occurred_at<o.created_at\\n\\\"\"}\n[tool_call name=execute_shell_command id=call_acf827a907ad4ddfba51b092]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT '领料物料≠采购单物料' chk, COUNT(*) n FROM wms_transactions w JOIN procurement_lines p ON p.purchase_line_id=w.reference_id WHERE w.material_id IS NOT NULL AND w.material_id<>'' AND w.material_id<>p.material_id\\nUNION ALL SELECT '流水unit_cost≠采购单unit_cost', COUNT(*) FROM wms_transactions w JOIN procurement_lines p ON p.purchase_line_id=w.reference_id WHERE ABS(IFNULL(w.unit_cost,0)-IFNULL(p.unit_cost,0))>0.005\\nUNION ALL SELECT '运单tracking_no重复', COUNT(*) FROM (SELECT tracking_no FROM shipments WHERE tracking_no IS NOT NULL AND tracking_no<>'' GROUP BY tracking_no HAVING COUNT(*)>1)\\nUNION ALL SELECT '同一订单多运单', COUNT(*) FROM (SELECT sales_order_id FROM shipments GROUP BY 1 HAVING COUNT(*)>1)\\nUNION ALL SELECT '运单route≠订单route', COUNT(*) FROM shipments s JOIN orders o ON o.sales_order_id=s.sales_order_id WHERE IFNULL(s.route_id,'')<>IFNULL(o.route_id,'')\\nUNION ALL SELECT '已签收运单无签收物流事件', COUNT(*) FROM shipments s LEFT JOIN logistics_events e ON e.shipment_id=s.shipment_id AND e.event_status LIKE '%签收%' WHERE s.status='已签收' AND e.logistics_event_id IS NULL\\nUNION ALL SELECT '在途运单却有签收事件', COUNT(*) FROM shipments s JOIN logistics_events e ON e.shipment_id=s.shipment_id WHERE s.status='在途' AND e.event_status LIKE '%签收%'\\nUNION ALL SELECT '签收事件时间≠received_at', COUNT(*) FROM shipments s JOIN logistics_events e ON e.shipment_id=s.shipment_id WHERE s.status='已签收' AND e.event_status LIKE '%签收%' AND e.event_at<>s.received_at\\nUNION ALL SELECT '物流事件早于发货', COUNT(*) FROM shipments s JOIN logistics_events e ON e.shipment_id=s.shipment_id WHERE e.event_at<s.dispatched_at\\nUNION ALL SELECT '签收晚于carrier_promised', COUNT(*) FROM shipments WHERE received_at IS NOT NULL AND carrier_promised_at IS NOT NULL AND received_at>carrier_promised_at\\n\\\"\\necho \\\"--- event_status 取值 ---\\\"\\npython3 datahub/scripts/query.py \\\"SELECT event_status, COUNT(*) n FROM logistics_events GROUP BY 1 ORDER BY 2 DESC\\\"\"}\n[tool_call name=execute_shell_command id=call_3e675ddd8f8847608b8b0463]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nWITH last_ship AS (SELECT sales_order_id, MAX(received_at) last_recv, SUM(quantity) sq FROM shipments GROUP BY 1)\\nSELECT '已全量签收但签收完成晚于承诺交期' chk, COUNT(*) n\\nFROM orders o JOIN last_ship l ON l.sales_order_id=o.sales_order_id\\nWHERE o.is_effective=1 AND l.sq>=o.quantity AND l.last_recv>o.promised_delivery_at\\nUNION ALL SELECT '承诺期已过但未全量签收(延期事实)', COUNT(*) FROM orders o LEFT JOIN last_ship l ON l.sales_order_id=o.sales_order_id\\nWHERE o.is_effective=1 AND o.promised_delivery_at<'2026-09-18T08:00:00+08:00' AND IFNULL(l.sq,0)<o.quantity\\nUNION ALL SELECT 'source_risk_flag取值数', COUNT(DISTINCT source_risk_flag) FROM orders\\n\\\"; echo \\\"--- risk flags ---\\\"\\npython3 datahub/scripts/query.py \\\"SELECT source_risk_flag, source_risk_reason, COUNT(*) n FROM orders GROUP BY 1,2 ORDER BY 3 DESC\\\"\"}\n[tool_call name=execute_shell_command id=call_43e10939022b4da388151225]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT '运单:carrier_promised早于发货' chk, COUNT(*) n FROM shipments WHERE carrier_promised_at IS NOT NULL AND carrier_promised_at<dispatched_at\\nUNION ALL SELECT '运单:carrier_promised晚于快照', COUNT(*) FROM shipments WHERE carrier_promised_at>'2026-09-18T08:00:00+08:00'\\nUNION ALL SELECT '运单:dispatched早于订单创建', COUNT(*) FROM shipments s JOIN orders o ON o.sales_order_id=s.sales_order_id WHERE s.dispatched_at<o.created_at\\nUNION ALL SELECT '工单:下达早于订单创建', COUNT(*) FROM work_orders t JOIN orders o ON o.sales_order_id=t.sales_order_id WHERE t.released_at<o.created_at\\nUNION ALL SELECT 'MES:开始早于工单下达', COUNT(*) FROM mes_events m JOIN work_orders t ON t.work_order_id=m.work_order_id WHERE m.start_at<t.released_at\\nUNION ALL SELECT 'MES:结束晚于计划完工', COUNT(*) FROM mes_events m JOIN work_orders t ON t.work_order_id=m.work_order_id WHERE m.end_at>t.planned_finish_at\\nUNION ALL SELECT '节点:计划开始早于工单下达', COUNT(*) FROM stage_nodes s JOIN work_orders t ON t.work_order_id=s.work_order_id WHERE s.planned_start_at<t.released_at\\nUNION ALL SELECT '节点:计划结束晚于承诺交期', COUNT(*) FROM stage_nodes s JOIN orders o ON o.sales_order_id=s.sales_order_id WHERE s.planned_end_at>o.promised_delivery_at\\nUNION ALL SELECT '节点:实际结束晚于计划结束(超时)', COUNT(*) FROM stage_nodes WHERE actual_end_at IS NOT NULL AND actual_end_at>planned_end_at\\nUNION ALL SELECT '节点:进行中且计划结束已过', COUNT(*) FROM stage_nodes WHERE actual_end_at IS NULL AND planned_end_at<'2026-09-18T08:00:00+08:00'\\nUNION ALL SELECT '报工:日期晚于快照', COUNT(*) FROM labor_logs WHERE work_date>'2026-09-18'\\nUNION ALL SELECT '出勤:日期晚于快照', COUNT(*) FROM attendance WHERE work_date>'2026-09-18'\\n\\\"\"}\n[tool_call name=execute_shell_command id=call_b9b7160d158341ffaa85f551]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT CAST(JULIANDAY(received_at)-JULIANDAY(carrier_promised_at) AS INTEGER) late_days, COUNT(*) n\\nFROM shipments WHERE received_at IS NOT NULL AND carrier_promised_at IS NOT NULL AND received_at>carrier_promised_at GROUP BY 1 ORDER BY 1 LIMIT 30\\\"\\necho \\\"--- 提前签收 ---\\\"\\npython3 datahub/scripts/query.py \\\"SELECT MIN(JULIANDAY(received_at)-JULIANDAY(carrier_promised_at)) min_diff, MAX(JULIANDAY(received_at)-JULIANDAY(carrier_promised_at)) max_diff, AVG(JULIANDAY(received_at)-JULIANDAY(carrier_promised_at)) avg_diff, COUNT(*) n FROM shipments WHERE received_at IS NOT NULL AND carrier_promised_at IS NOT NULL\\\"\"}\n[tool_call name=execute_shell_command id=call_41f52cb8792f46cca47dfc17]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT movement_type, warehouse_id, COUNT(*) n FROM wms_transactions GROUP BY 1,2 ORDER BY 1\\\"\\necho \\\"--- 库存余额（按仓/物料域） ---\\\"\\npython3 datahub/scripts/query.py \\\"\\nSELECT warehouse_id, COALESCE(NULLIF(material_id,''),NULLIF(product_id,'')) item, unit,\\n  SUM(signed_quantity) balance, SUM(CASE WHEN signed_quantity>0 THEN signed_quantity ELSE 0 END) in_qty,\\n  SUM(CASE WHEN signed_quantity<0 THEN -signed_quantity ELSE 0 END) out_qty\\nFROM wms_transactions GROUP BY 1,2,3 ORDER BY 1,2\\\"\"}\n[tool_call name=execute_shell_command id=call_d2969bb5aeb140b8aade2a1a]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nWITH conv AS (SELECT w.sales_order_id, MIN(w.occurred_at) t, SUM(-w.signed_quantity) q FROM wms_transactions w WHERE w.movement_type='外购转成品' GROUP BY 1)\\nSELECT c.sales_order_id, o.quantity, o.unit, o.fulfillment_mode, c.t conv_at,\\n  ROUND(JULIANDAY('2026-09-18T08:00:00+08:00')-JULIANDAY(c.t),1) elapsed_days,\\n  o.promised_delivery_at,\\n  (SELECT COUNT(*) FROM shipments s WHERE s.sales_order_id=c.sales_order_id) ships,\\n  o.source_risk_flag, o.source_risk_reason\\nFROM conv c JOIN orders o ON o.sales_order_id=c.sales_order_id\\nWHERE c.sales_order_id NOT IN (SELECT sales_order_id FROM wms_transactions WHERE movement_type='成品入库')\\nORDER BY elapsed_days DESC\\\"\"}\n[tool_call name=execute_shell_command id=call_9e0d9a922c114146a166ee5b]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nWITH m AS (\\n SELECT w.sales_order_id, o.quantity q, o.unit u, o.product_id,\\n   SUM(CASE WHEN w.movement_type='生产领料' THEN -w.signed_quantity ELSE 0 END) pick,\\n   SUM(CASE WHEN w.movement_type='生产损耗出库' THEN -w.signed_quantity ELSE 0 END) loss,\\n   SUM(CASE WHEN w.movement_type='成品入库' THEN w.signed_quantity ELSE 0 END) fg\\n FROM wms_transactions w JOIN orders o ON o.sales_order_id=w.sales_order_id\\n WHERE o.fulfillment_mode='自产' GROUP BY 1)\\nSELECT product_id, u, COUNT(*) orders_,\\n  ROUND(MIN(pick*1.0/q),2) min_ratio, ROUND(MAX(pick*1.0/q),2) max_ratio, ROUND(AVG(pick*1.0/q),2) avg_ratio,\\n  SUM(CASE WHEN pick=0 THEN 1 ELSE 0 END) no_pick, SUM(CASE WHEN fg>q THEN 1 ELSE 0 END) fg_gt_ord\\nFROM m GROUP BY 1,2 ORDER BY 1\\\"\"}\n[tool_call name=execute_shell_command id=call_d490be1952e64c36ba4d8963]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nWITH m AS (SELECT w.sales_order_id, o.quantity q,\\n   SUM(CASE WHEN w.movement_type='生产领料' THEN -w.signed_quantity ELSE 0 END) pick,\\n   SUM(CASE WHEN w.movement_type='生产损耗出库' THEN -w.signed_quantity ELSE 0 END) loss\\n FROM wms_transactions w JOIN orders o ON o.sales_order_id=w.sales_order_id WHERE o.fulfillment_mode='自产' GROUP BY 1)\\nSELECT sales_order_id, q, pick, loss, ROUND(pick*1.0/q,3) ratio FROM m\\nWHERE pick*1.0/q NOT IN (SELECT DISTINCT ROUND(pick*1.0/q,3) FROM m WHERE 1=0)\\nORDER BY ABS(pick*1.0/q - 4) DESC LIMIT 15\\\"\\necho \\\"--- ratio 分布 ---\\\"\\npython3 datahub/scripts/query.py \\\"\\nWITH m AS (SELECT w.sales_order_id, o.quantity q, o.product_id,\\n   SUM(CASE WHEN w.movement_type='生产领料' THEN -w.signed_quantity ELSE 0 END) pick\\n FROM wms_transactions w JOIN orders o ON o.sales_order_id=w.sales_order_id WHERE o.fulfillment_mode='自产' GROUP BY 1)\\nSELECT product_id, CAST(pick AS REAL)/q ratio, COUNT(*) n FROM m GROUP BY 1,2 ORDER BY 1,2\\\"\"}\n[tool_call name=execute_shell_command id=call_6425e68eb6ce4745946e7b31]\ninput={\"command\": \"python3 datahub/scripts/query.py \\\"\\nSELECT transaction_id, movement_type, material_id, product_id, lot_id, signed_quantity, unit, occurred_at, reference_id\\nFROM wms_transactions WHERE sales_order_id='SO20260906-0201' ORDER BY occurred_at\\\"\\necho \\\"--- 该单订单/工单信息 ---\\\"\\npython3 datahub/scripts/query.py \\\"\\nSELECT o.sales_order_id,o.quantity,o.unit,o.product_id,o.fulfillment_mode,o.created_at,o.promised_delivery_at,o.source_risk_flag,o.source_risk_reason,t.work_order_id,t.planned_quantity,t.released_at,t.planned_finish_at\\nFROM orders o LEFT JOIN work_orders t ON t.sales_order_id=o.sales_order_id WHERE o.sales_order_id='SO20260906-0201'\\\"\\necho \\\"--- 该单质检/发货 ---\\\"\\npython3 datahub/scripts/query.py \\\"SELECT inspection_id,inspected_quantity,acce