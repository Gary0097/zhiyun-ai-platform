          {
            "created_at": "2026-09-17T23:03:18.310582",
            "finished_at": null,
            "id": "chatcmpl-tool-98663347f10428f3",
            "input": "{\"agent_id\": \"a56d60fe-1eff-4661-8a6e-d717edc86cf8\", \"knowledge_base_ids\": [\"b861158f-4b89-4715-bada-01d4bed1e40b\", \"facd1c48-1d9b-4ccf-aced-3dce4420234e\", \"f9730005-3478-4100-8845-d10f762b565e\", \"7d8ea66b-bea8-4e08-b72f-1952471a8863\"], \"query\": \"设备封口漏气怎么处理？\", \"session_id\": \"ce7a4660-0e4c-4d01-a85c-cbd8497e12c2\"}",
            "name": "weknora__agent_chat",
