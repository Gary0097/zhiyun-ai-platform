{
  "id": "zhiyun-app-discovery",
  "name": "应用与项目中心",
  "version": "0.2.0",
  "type": "app",
  "description": "统一展示真实安装应用、能力搜索及31项PRD功能交付进度，明确区分已安装与未开发。",
  "author": "Zhiyun AI",
  "entry": {
    "backend": "app_discovery_plugin.py",
    "frontend": "ui/index.js"
  },
  "dependencies": [],
  "qwenpaw_version": {
    "min": "2.1.0",
    "max": "2.2.0"
  },
  "meta": {
    "pawapp": {
      "icon": "🔎",
      "category": "system",
      "entry_page": "/apps/app-discovery",
      "launch_scope": "page"
    },
    "permissions": {
      "chat": true,
      "storage": false
    },
    "features": ["installed-apps", "local-app-index", "capability-search", "agent-app-routing", "project-progress"]
  }
}
