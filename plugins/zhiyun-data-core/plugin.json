{
  "id": "zhiyun-data-core",
  "name": "AI-OS Data Core",
  "version": "0.7.0",
  "type": "app",
  "description": "面向全部 PawApp 的 Workspace 统一数据库、Schema Registry、导入批次和模拟数据服务。",
  "author": "Zhiyun AI",
  "entry": {
    "backend": "data_core_plugin.py",
    "frontend": "ui/index.js"
  },
  "dependencies": ["openpyxl>=3.1,<4", "python-multipart>=0.0.9,<1", "cryptography>=45,<51"],
  "qwenpaw_version": {
    "min": "2.1.0",
    "max": "2.2.0"
  },
  "meta": {
    "pawapp": {
      "icon": "🗄️",
      "category": "system",
      "entry_page": "/apps/data-core",
      "launch_scope": "page"
    },
    "permissions": {
      "chat": true,
      "storage": true
    },
    "features": ["workspace-sqlite", "schema-registry", "migration-journal", "verified-backup", "encrypted-backup", "confirmed-recovery", "custom-datasets", "production-template", "generic-excel-import", "import-preview", "simulation-batches", "batch-rollback", "data-browser", "schema-preview", "bounded-order-query"]
  }
}
